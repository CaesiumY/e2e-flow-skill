    },
    // 모바일 분기가 필요하면 주석 해제.
    // CI 에서는 nightly 티어만 --project 를 지정하지 않으므로, 켜는 즉시 야간에만 자동 포함된다.
    // {
    //   name: 'chromium-mobile',
    //   use: { ...devices['Pixel 7'] },
    // },
  ],

  // 개발 서버 자동 기동. CI 에서도 반드시 필요하다 — 워크플로우는 빌드 산출물만 내려받고
  // 서버를 직접 띄우지 않으므로, 이 블록이 없으면 모든 테스트가 ERR_CONNECTION_REFUSED 로 실패한다.
  //
