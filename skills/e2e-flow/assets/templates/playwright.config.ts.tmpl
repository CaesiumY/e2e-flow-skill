const CI_WORKERS = parseInt(process.env.E2E_WORKERS ?? '', 10) || 2;

export default defineConfig({
  testDir: './e2e',
  fullyParallel: true,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 2 : 0,
  workers: process.env.CI ? CI_WORKERS : undefined,
  reporter: process.env.CI ? [['blob'], ['list']] : 'list',

  use: {
    baseURL: BASE_URL,
    // 첫 실패에도 trace.zip 보존 — Self-Healer가 trace를 분석해 분류·패치 제안
    trace: 'retain-on-failure',
    screenshot: 'only-on-failure',
    video: 'retain-on-failure',
    actionTimeout: 10_000,
    navigationTimeout: 30_000,
  },

  expect: {
    timeout: 5_000,
    // VRT 기본값 — 자세한 운영은 references/phase-4-enhance.md
