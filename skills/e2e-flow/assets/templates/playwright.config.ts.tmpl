  // 프레임워크 기본 포트를 믿지 말 것 (예: vite dev 는 5173, vite preview 는 4173).
  webServer: USE_LOCAL_SERVER
    ? {
        command: process.env.CI ? '{{START_CMD}}' : '{{PACKAGE_MANAGER}} run dev',
