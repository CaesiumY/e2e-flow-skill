# .github/workflows/playwright.yml
# Generated by e2e-flow skill (Phase 4).
#
# 티어링 기반 E2E 워크플로우 — "무엇이 바뀌었고 어디로 가는 PR인가"에 따라 실행 범위를 나눈다.
#
#   skip     실행 없음                        e2e:skip 라벨 / draft PR / E2E 무관 경로만 변경
#   smoke    @smoke 만, shard 1               PR 기본값
#   scoped   변경 영향 도메인만               e2e/ci-scope.json 이 있을 때만 (선택 기능)
#   critical @smoke|@critical                 기본 브랜치 push / merge queue
#   full     전체                             e2e:full 라벨
#   nightly  전체 + config 의 모든 project    스케줄
#
# 모든 티어는 @vrt 를 제외한다 (VRT 는 CI 게이트로 강제하지 않는다 — 맨 아래 주석 블록 참고).
#
# branch protection 에는 **"E2E Gate" 하나만** required check 로 등록한다.
# shard 개수가 동적이라 개별 job 이름을 required 로 걸 수 없기 때문이다.
#
# 상세 설계·치환 규칙은 스킬의 references/phase-4-enhance.md 4.2 참고.

name: E2E Tests

on:
  pull_request:
    # labeled 만 넣으면 "라벨을 붙인 그 순간" 1회만 돌고 이후 push 에는 돌지 않는다.
    # 아래처럼 전체 타입을 받고, 게이트는 decide job 에서 '현재 라벨 상태'로 판정한다.
    types:
      - opened
      - synchronize
      - reopened
      - labeled
      - unlabeled
      - ready_for_review
      - converted_to_draft
  push:
    branches: ['{{DEFAULT_BRANCH}}']
  merge_group:
  # 야간 실행이 필요 없으면 아래 schedule 블록 2줄을 삭제한다.
  schedule:
    - cron: '{{NIGHTLY_CRON}}'
  workflow_dispatch:
    inputs:
      tier:
        description: '실행 티어'
        type: choice
        options: [smoke, critical, full, nightly]
        default: full

# decide job 이 gh api 로 PR 변경 파일 목록을 읽는다.
permissions:
  contents: read
  pull-requests: read

concurrency:
  # event_name 을 포함해 기본 브랜치 push 와 schedule 이 서로 큐잉되지 않게 한다.
  group: e2e-${{ github.event_name }}-${{ github.ref }}
  # PR 만 취소한다 — push·schedule 결과는 회귀 이력이므로 보존.
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

env:
  PACKAGE_MANAGER: {{PACKAGE_MANAGER}}

jobs:
  # =================================================================
  # 1. decide — 티어 결정. checkout 은 ci-scope.json 만 sparse 로 받는다.
  # =================================================================
  decide:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      tier: ${{ steps.tier.outputs.tier }}
      paths: ${{ steps.tier.outputs.paths }}
      reason: ${{ steps.tier.outputs.reason }}
    steps:
      - name: PR 변경 파일 수집
        id: files
        if: github.event_name == 'pull_request'
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          PR_CHANGED_FILES: ${{ github.event.pull_request.changed_files }}
        run: |
          set -uo pipefail
          if ! FILES=$(gh api "repos/${REPO}/pulls/${PR_NUMBER}/files" --paginate --jq '.[].filename'); then
            # 폴백은 '실행하는' 쪽 — 단, 경로 skip 이 조용히 무력화되지 않도록 경고를 남긴다.
            echo "::warning::PR 변경 파일 조회에 실패했습니다. 경로 기반 skip 을 건너뛰고 실행합니다."
            echo "api-ok=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          # 이 엔드포인트는 최대 3000개까지만 돌려준다. 목록이 잘린 채로 판정하면
          # 3000번째 뒤에 있는 소스 변경을 못 보고 skip(초록불)으로 빠질 수 있다.
          GOT=$(printf '%s\n' "$FILES" | grep -c '[^[:space:]]' || true)
          if [ "${PR_CHANGED_FILES:-0}" -gt "${GOT:-0}" ]; then
            echo "::warning::변경 파일 목록이 잘렸습니다 (${GOT}/${PR_CHANGED_FILES}). 경로 기반 skip 을 건너뛰고 실행합니다."
            echo "api-ok=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          echo "api-ok=true" >> "$GITHUB_OUTPUT"
          {
            echo 'list<<E2E_FILES_EOF'
            printf '%s\n' "$FILES"
            echo 'E2E_FILES_EOF'
          } >> "$GITHUB_OUTPUT"

      # 선택 기능(도메인 스코프)용. 파일이 없으면 sparse checkout 결과가 비어 있을 뿐 실패하지 않는다.
      - name: ci-scope.json 가져오기 (선택 기능)
        if: github.event_name == 'pull_request'
        uses: actions/checkout@v4
        with:
          sparse-checkout: e2e/ci-scope.json
          sparse-checkout-cone-mode: false
          fetch-depth: 1

      - name: 티어 결정
        id: tier
        env:
          # 라벨·파일명은 사용자 제어 입력이다. run: 에 ${{ }} 로 직접 보간하면
          # 스크립트 인젝션이 되므로 반드시 env 를 경유한다.
          EVENT: ${{ github.event_name }}
          # 라벨명에는 쉼표가 들어갈 수 있다. join(...,',') 로 이어 붙이면 경계가 사라져
          # 'review,e2e:skip' 이라는 단일 라벨이 'e2e:skip' 으로 오인된다 — JSON 배열로 넘긴다.
          LABELS_JSON: ${{ toJSON(github.event.pull_request.labels.*.name) }}
          DRAFT: ${{ github.event.pull_request.draft }}
          DISPATCH_TIER: ${{ inputs.tier }}
          API_OK: ${{ steps.files.outputs.api-ok }}
          CHANGED_FILES: ${{ steps.files.outputs.list }}
          SKIP_PATHS_REGEX: '{{SKIP_PATHS_REGEX}}'
        run: |
          set -uo pipefail

          # jq 가 없으면 아래 라벨 판정이 '라벨 없음' 과 구분되지 않는 채로 실패한다
          # (e2e:full 을 붙였는데 smoke 만 도는, 조용한 저테스트). 크게 실패시킨다.
          # GitHub 호스팅 러너에는 기본 탑재되어 있고, self-hosted 러너에서만 문제가 된다.
          if ! command -v jq >/dev/null 2>&1; then
            echo "::error::jq 를 찾을 수 없습니다. 이 워크플로우는 라벨 판정·도메인 스코프·매트릭스 생성에 jq 를 사용합니다. self-hosted 러너라면 jq 를 설치하세요."
            exit 1
          fi

          # JSON 배열 원소와의 정확 일치. 구분자 방식은 두 가지를 다 놓친다 —
          # 부분 문자열 매치는 'e2e:full-stack' 을, 쉼표 결합은 쉼표가 든 라벨명을 오인한다.
          #
          # jq -e 는 '일치 없음' 에 1, '동작 실패'(파싱 오류·깨진 설치 등)에 1보다 큰 값을 낸다.
          # 이 둘을 뭉뚱그려 non-zero = '라벨 없음' 으로 읽으면, e2e:full 을 붙였는데 smoke 만
          # 도는 조용한 저테스트가 그대로 되살아난다. exit 1 만 음성으로 인정하고 나머지는 중단한다.
          has_label() {
            case "$LABELS_JSON" in
              ''|null) return 1 ;;
            esac
            local rc
            printf '%s' "$LABELS_JSON" | jq -e --arg l "$1" 'any(.[]; . == $l)' >/dev/null
            rc=$?
            case "$rc" in
              0) return 0 ;;
              1) return 1 ;;
              *) echo "::error::라벨 판정 중 jq 가 실패했습니다 (exit $rc). LABELS_JSON=$LABELS_JSON"
                 exit 1 ;;
            esac
          }

          # --- 경로 관련성 판정 (PR + API 성공일 때만) ---
          RELEVANT=true
          if [ "$EVENT" = "pull_request" ] && [ "$API_OK" = "true" ]; then
            if [ -z "$(printf '%s' "$CHANGED_FILES" | tr -d '[:space:]')" ]; then
              # 변경 파일 0개 — 목록이 비었다는 것만으로 건너뛰지 않는다 (안전한 쪽).
              RELEVANT=true
            elif printf '%s\n' "$CHANGED_FILES" | grep -vE "$SKIP_PATHS_REGEX" | grep -q '[^[:space:]]'; then
              # 무관 패턴에 걸리지 '않는' 파일이 하나라도 있으면 관련 있음.
              RELEVANT=true
            else
              RELEVANT=false
            fi
          fi

          # --- 결정 표 (위에서부터 첫 매치) ---
          # 명시적 라벨이 암묵 판정(draft·경로)보다 위에 온다.
          if [ "$EVENT" = "workflow_dispatch" ] && [ -n "$DISPATCH_TIER" ]; then
            TIER="$DISPATCH_TIER"; REASON="수동 실행 (workflow_dispatch)"
          elif has_label 'e2e:skip'; then
            TIER=skip;     REASON="e2e:skip 라벨"
          elif has_label 'e2e:full'; then
            TIER=full;     REASON="e2e:full 라벨"
          elif [ "$DRAFT" = "true" ]; then
            TIER=skip;     REASON="draft PR (e2e:full 라벨로 강제 실행 가능)"
          elif [ "$EVENT" = "pull_request" ] && [ "$RELEVANT" = "false" ]; then
            TIER=skip;     REASON="E2E 무관 경로만 변경"
          elif [ "$EVENT" = "schedule" ]; then
            TIER=nightly;  REASON="야간 스케줄"
          elif [ "$EVENT" = "push" ] || [ "$EVENT" = "merge_group" ]; then
            TIER=critical; REASON="기본 브랜치 반영"
          else
            TIER=smoke;    REASON="PR 기본값"
          fi

          # --- 도메인 스코프 (선택 기능: e2e/ci-scope.json 이 있을 때만) ---
          # PR 기본 티어(smoke)를 '넓히는' 기능이다. e2e:full 은 명시 의사이므로 절대 좁히지 않는다.
          # API_OK 확인이 필수다 — 변경 파일 목록을 못 받은 상태에서는 '매칭 도메인 0개' 와
          # '조회 실패' 를 구분할 수 없어, 스코핑을 돌리면 fallback(기본 full)으로 조용히 승격된다.
          PATHS=""
          if [ "$TIER" = "smoke" ] && [ "$API_OK" = "true" ] && [ -f e2e/ci-scope.json ]; then
            printf '%s\n' "$CHANGED_FILES" > "$RUNNER_TEMP/changed.txt"

            # 표준입력으로 받은 글롭 목록 중 하나라도 변경 파일에 매치되면 0 을 반환한다.
            # bash case 글롭이라 '*' 가 '/' 를 가로질러 매치된다 — 항상 넓게 판정하는 쪽이라 안전하다.
            match_any() {
              local pat f
              while IFS= read -r pat; do
                [ -z "$pat" ] && continue
                while IFS= read -r f; do
                  [ -z "$f" ] && continue
                  case "$f" in $pat) return 0 ;; esac
                done < "$RUNNER_TEMP/changed.txt"
              done
              return 1
            }

            FALLBACK=$(jq -r '.fallback // "full"' e2e/ci-scope.json)
            case "$FALLBACK" in
              full|smoke) ;;
              *) echo "::warning::ci-scope.json 의 fallback 값이 올바르지 않습니다 ('$FALLBACK') — full 로 처리합니다."
                 FALLBACK=full ;;
            esac

            if jq -r '.always[]? // empty' e2e/ci-scope.json | match_any; then
              TIER=full; REASON="ci-scope: always 경로 변경"
            else
              MATCHED=""
              while IFS= read -r DOMAIN; do
                [ -z "$DOMAIN" ] && continue
                # 도메인명은 경로 인자로 쉘에 전달되므로 문자셋을 제한한다 (인젝션 차단).
                case "$DOMAIN" in
                  *[!A-Za-z0-9._-]*)
                    echo "::warning::ci-scope.json 의 도메인명 '$DOMAIN' 에 허용되지 않은 문자가 있어 무시합니다."
                    continue ;;
                esac
                if jq -r --arg d "$DOMAIN" '.domains[$d][]? // empty' e2e/ci-scope.json | match_any; then
                  MATCHED="$MATCHED e2e/tests/$DOMAIN"
                fi
              done < <(jq -r '.domains // {} | keys[]' e2e/ci-scope.json)

              if [ -n "$MATCHED" ]; then
                TIER=scoped; REASON="ci-scope: 영향 도메인$MATCHED"
                PATHS="${MATCHED# }"
              else
                TIER="$FALLBACK"; REASON="ci-scope: 매칭 도메인 없음 → fallback=$FALLBACK"
              fi
            fi
          fi

          echo "tier=$TIER"     >> "$GITHUB_OUTPUT"
          echo "paths=$PATHS"   >> "$GITHUB_OUTPUT"
          echo "reason=$REASON" >> "$GITHUB_OUTPUT"

          # 마지막 명령이 조건부면 그 종료 코드가 스텝 전체의 종료 코드가 된다.
          # `[ ... ] && echo` 를 마지막에 두면 조건이 거짓일 때 스텝이 실패하므로 if 를 쓴다.
          {
            echo "### E2E 실행 계획"
            echo ""
            echo "| 항목 | 값 |"
            echo "|---|---|"
            echo "| 티어 | \`$TIER\` |"
            echo "| 근거 | $REASON |"
            echo "| 이벤트 | \`$EVENT\` |"
            if [ -n "$PATHS" ]; then
              echo "| 스코프 경로 | \`$PATHS\` |"
            fi
          } >> "$GITHUB_STEP_SUMMARY"

  # =================================================================
  # 2. build — 앱 빌드 + 테스트 개수 측정 + shard 매트릭스 생성.
  #    개수 측정은 브라우저가 필요 없으므로 별도 job 으로 쪼개지 않는다
  #    (쪼개면 checkout+install 1분을 한 번 더 내고 얻는 건 10초뿐이다).
  # =================================================================
  build:
    needs: decide
    if: needs.decide.outputs.tier != 'skip'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    outputs:
      tier: ${{ steps.count.outputs.tier }}
      grep: ${{ steps.count.outputs.grep }}
      paths: ${{ steps.count.outputs.paths }}
      project: ${{ steps.count.outputs.project }}
      matrix: ${{ steps.count.outputs.matrix }}
      total: ${{ steps.count.outputs.total }}
      timeout: ${{ steps.count.outputs.timeout }}
      pw-version: ${{ steps.pw-version.outputs.v }}
    steps:
      - uses: actions/checkout@v4
      # pnpm/action-setup 은 version 입력이나 package.json 의 packageManager 필드 중
      # 하나가 반드시 있어야 한다. 둘 다 없으면 "No pnpm version is specified" 로 실패한다.
      - uses: pnpm/action-setup@v4
        if: env.PACKAGE_MANAGER == 'pnpm'
      - uses: actions/setup-node@v4
        with:
          node-version: '{{NODE_VERSION}}'
          cache: '{{PACKAGE_MANAGER}}'
      - run: {{INSTALL_CMD}}

      # 브라우저 캐시를 여기서 채워 두면 뒤따르는 shard 들이 전부 캐시 히트한다.
      # 키는 lockfile 해시가 아니라 Playwright 버전 — 무관한 의존성 변경에 캐시가 깨지지 않도록.
      - name: Playwright 버전 확인
        id: pw-version
        run: echo "v=$(node -p "require('@playwright/test/package.json').version")" >> "$GITHUB_OUTPUT"
      - uses: actions/cache@v4
        id: pw-cache
        with:
          path: ~/.cache/ms-playwright
          key: pw-${{ runner.os }}-${{ steps.pw-version.outputs.v }}
      - name: 브라우저 바이너리 내려받기 (캐시 미스일 때만)
        if: steps.pw-cache.outputs.cache-hit != 'true'
        run: {{PW_EXEC}} playwright install chromium

      - name: 테스트 개수 측정 + 매트릭스 생성
        id: count
        env:
          TIER: ${{ needs.decide.outputs.tier }}
          SCOPE_PATHS: ${{ needs.decide.outputs.paths }}
        run: |
          set -uo pipefail

          # decide job 과 별개 러너다 — 여기서도 확인한다 (매트릭스 생성에 jq 를 쓴다).
          if ! command -v jq >/dev/null 2>&1; then
            echo "::error::jq 를 찾을 수 없습니다. shard 매트릭스 생성에 필요합니다. self-hosted 러너라면 jq 를 설치하세요."
            exit 1
          fi

          set_params() {
            case "$1" in
              # smoke 는 shard 1 고정 — 테스트 몇 개를 쪼개면 job 오버헤드가 실행 시간보다 크다.
              smoke)    GREP='@smoke';           DENSITY=100000; MAX=1; TIMEOUT=10; PROJECT='{{PRIMARY_PROJECT}}' ;;
              scoped)   GREP='';                 DENSITY=15;     MAX=4; TIMEOUT=20; PROJECT='{{PRIMARY_PROJECT}}' ;;
              critical) GREP='@smoke|@critical'; DENSITY=20;     MAX=4; TIMEOUT=20; PROJECT='{{PRIMARY_PROJECT}}' ;;
              full)     GREP='';                 DENSITY=15;     MAX=8; TIMEOUT=30; PROJECT='{{PRIMARY_PROJECT}}' ;;
              # nightly 는 밀도를 높이고 상한을 낮춰 job 수를 최소화한다 (시간 무관, 비용 우선).
              # --project 를 지정하지 않아 config 에 정의된 모든 project 가 돈다.
              nightly)  GREP='';                 DENSITY=40;     MAX=3; TIMEOUT=60; PROJECT='' ;;
              *) echo "::error::알 수 없는 티어: $1"; exit 1 ;;
            esac
          }

          # 카운트와 실행은 반드시 같은 인자를 써야 한다.
          # 인자가 갈라지면 "5개 세고 0개 실행"이 조용히 통과한다.
          count_tests() {
            local args OUT
            args=(test --list --pass-with-no-tests --grep-invert '@vrt')
            [ -n "$GREP" ] && args+=(--grep "$GREP")
            [ -n "$PROJECT" ] && args+=(--project "$PROJECT")
            # shellcheck disable=SC2086
            if ! OUT=$({{PW_EXEC}} playwright "${args[@]}" $RUN_PATHS 2>&1); then
              printf '%s\n' "$OUT" >&2
              return 1
            fi
            printf '%s\n' "$OUT" | awk '/^[[:space:]]*Total:/ {n=$2} END {print n+0}'
          }

          set_params "$TIER"
          RUN_PATHS=''
          [ "$TIER" = "scoped" ] && RUN_PATHS="$SCOPE_PATHS"

          if ! TOTAL=$(count_tests); then
            echo "::error::테스트 목록 조회에 실패했습니다."
            exit 1
          fi

          # 0-매칭 승격 — 태그를 아직 안 붙인 프로젝트에서 '아무것도 안 돌았는데 초록불'을 막는다.
          PROMOTED=""
          if [ "$TOTAL" -eq 0 ] && [ "$TIER" != "full" ] && [ "$TIER" != "nightly" ]; then
            echo "::warning::티어 '$TIER' 에 매칭되는 테스트가 0개입니다 — full 로 승격합니다. (@smoke/@critical 태그를 아직 부여하지 않았을 수 있습니다)"
            PROMOTED="$TIER"
            TIER=full
            set_params "$TIER"
            RUN_PATHS=''
            if ! TOTAL=$(count_tests); then
              echo "::error::테스트 목록 조회에 실패했습니다."
              exit 1
            fi
          fi

          if [ "$TOTAL" -eq 0 ]; then
            echo "::warning::실행할 테스트가 하나도 없습니다. E2E 실행을 건너뜁니다."
            SHARDS=0
            MATRIX='[]'
          else
            SHARDS=$(( (TOTAL + DENSITY - 1) / DENSITY ))
            [ "$SHARDS" -lt 1 ] && SHARDS=1
            [ "$SHARDS" -gt "$MAX" ] && SHARDS="$MAX"
            MATRIX=$(jq -cn --argjson c "$SHARDS" \
              '[range(1; $c + 1) | {"shard-index": ., "total-shards": $c}]')
          fi

          {
            echo "tier=$TIER"
            echo "grep=$GREP"
            echo "paths=$RUN_PATHS"
            echo "project=$PROJECT"
            echo "total=$TOTAL"
            echo "timeout=$TIMEOUT"
            echo "matrix=$MATRIX"
          } >> "$GITHUB_OUTPUT"

          {
            echo "| 실행 티어 | \`$TIER\`${PROMOTED:+ (\`$PROMOTED\` 에서 승격 — 매칭 0개)} |"
            echo "| 테스트 수 | $TOTAL |"
            echo "| shard | $SHARDS (상한 $MAX) |"
            echo "| job 타임아웃 | ${TIMEOUT}분 |"
          } >> "$GITHUB_STEP_SUMMARY"

      - run: {{BUILD_CMD}}

      - name: 빌드 결과 업로드
        uses: actions/upload-artifact@v4
        with:
          name: e2e-build
          path: |
            .next
            !.next/cache
            dist
            build
          if-no-files-found: ignore
          retention-days: 1

  # =================================================================
  # 3. e2e-test — shard 병렬 실행.
  #    앱 서버는 playwright.config.ts 의 webServer 가 {{START_CMD}} 로 직접 띄운다.
  # =================================================================
  e2e-test:
    needs: [decide, build]
    if: needs.build.outputs.total != '0'
    runs-on: ubuntu-latest
    timeout-minutes: ${{ fromJSON(needs.build.outputs.timeout) }}
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.build.outputs.matrix) }}
    steps:
      - uses: actions/checkout@v4
      # pnpm/action-setup 은 version 입력이나 package.json 의 packageManager 필드 중
      # 하나가 반드시 있어야 한다. 둘 다 없으면 "No pnpm version is specified" 로 실패한다.
      - uses: pnpm/action-setup@v4
        if: env.PACKAGE_MANAGER == 'pnpm'
      - uses: actions/setup-node@v4
        with:
          node-version: '{{NODE_VERSION}}'
          cache: '{{PACKAGE_MANAGER}}'
      - run: {{INSTALL_CMD}}

      # build job 과 동일한 키 — 거기서 이미 채워 두었으므로 여기서는 항상 히트한다.
      - uses: actions/cache@v4
        with:
          path: ~/.cache/ms-playwright
          key: pw-${{ runner.os }}-${{ needs.build.outputs.pw-version }}
          restore-keys: pw-${{ runner.os }}-
      # 바이너리는 build job 이 채운 캐시에서 오고, 여기서는 OS 의존 패키지만 설치된다.
      # 러너 이미지가 이미 의존 패키지를 갖추고 있다면 --with-deps 를 빼도 된다.
      - run: {{PW_EXEC}} playwright install --with-deps chromium

      - uses: actions/download-artifact@v4
        with:
          name: e2e-build
          path: .

      - name: Playwright 실행
        env:
          GREP: ${{ needs.build.outputs.grep }}
          RUN_PATHS: ${{ needs.build.outputs.paths }}
          PROJECT: ${{ needs.build.outputs.project }}
          SHARD_INDEX: ${{ matrix.shard-index }}
          TOTAL_SHARDS: ${{ matrix.total-shards }}
        run: |
          set -uo pipefail
          args=(test --pass-with-no-tests --grep-invert '@vrt' --reporter=blob)
          args+=("--shard=${SHARD_INDEX}/${TOTAL_SHARDS}")
          [ -n "$GREP" ] && args+=(--grep "$GREP")
          [ -n "$PROJECT" ] && args+=(--project "$PROJECT")
          # shellcheck disable=SC2086
          {{PW_EXEC}} playwright "${args[@]}" $RUN_PATHS

      - name: 리포트 blob 업로드
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@v4
        with:
          name: e2e-blob-${{ matrix.shard-index }}
          path: blob-report
          retention-days: 1

  # =================================================================
  # 4. merge-reports — 실패했을 때만 shard 리포트를 하나의 HTML 로 병합
  # =================================================================
  merge-reports:
    needs: [build, e2e-test]
    if: ${{ !cancelled() && needs.e2e-test.result == 'failure' }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      # pnpm/action-setup 은 version 입력이나 package.json 의 packageManager 필드 중
      # 하나가 반드시 있어야 한다. 둘 다 없으면 "No pnpm version is specified" 로 실패한다.
      - uses: pnpm/action-setup@v4
        if: env.PACKAGE_MANAGER == 'pnpm'
      - uses: actions/setup-node@v4
        with:
          node-version: '{{NODE_VERSION}}'
          cache: '{{PACKAGE_MANAGER}}'
      - run: {{INSTALL_CMD}}

      - uses: actions/download-artifact@v4
        with:
          pattern: e2e-blob-*
          merge-multiple: true
          path: blob-reports

      - run: {{PW_EXEC}} playwright merge-reports --reporter html ./blob-reports

      - uses: actions/upload-artifact@v4
        with:
          name: e2e-html-report
          path: playwright-report
          retention-days: 7

  # =================================================================
  # 5. E2E Gate — branch protection 에 등록할 단일 required check.
  #
  #    "skipped = 통과" 는 tier=skip 또는 테스트 0개일 때만 허용된다.
  #    그 밖의 skipped 는 전부 상위 job 실패의 결과이므로 실패로 판정한다.
  # =================================================================
  e2e-gate:
    name: E2E Gate
    needs: [decide, build, e2e-test]
    # always() 가 아니라 !cancelled() — 취소된 run 에서 gate 가 돌아 빨간 마킹을 남기지 않도록.
    if: ${{ !cancelled() }}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: 판정
        env:
          DECIDE_RESULT: ${{ needs.decide.result }}
          BUILD_RESULT: ${{ needs.build.result }}
          TEST_RESULT: ${{ needs.e2e-test.result }}
          TIER: ${{ needs.decide.outputs.tier }}
          TOTAL: ${{ needs.build.outputs.total }}
          REASON: ${{ needs.decide.outputs.reason }}
        run: |
          set -uo pipefail

          if [ "$DECIDE_RESULT" != "success" ]; then
            echo "::error::티어 결정 job 이 실패했습니다 (decide=$DECIDE_RESULT)."
            exit 1
          fi

          if [ "$TIER" = "skip" ]; then
            echo "::notice::E2E 를 건너뛰었습니다 — $REASON"
            exit 0
          fi

          if [ "$BUILD_RESULT" != "success" ]; then
            echo "::error::build job 이 실패했습니다 (build=$BUILD_RESULT). E2E 가 실행되지 않았습니다."
            exit 1
          fi

          if [ "${TOTAL:-0}" = "0" ]; then
            echo "::warning::실행된 테스트가 0개입니다. 스위트가 비어 있는지 확인하세요."
            exit 0
          fi

          if [ "$TEST_RESULT" = "success" ]; then
            echo "::notice::E2E 통과 (tier=$TIER, tests=$TOTAL)"
            exit 0
          fi

          echo "::error::E2E 실패 (tier=$TIER, e2e-test=$TEST_RESULT). Actions 탭의 e2e-html-report 아티팩트를 확인하세요."
          exit 1

# =================================================================
# (선택) 야간 VRT — 기본 비활성.
#
# 스냅샷 파일명에는 플랫폼 접미사가 붙는다 (예: landing-chromium-desktop-linux.png).
# 로컬 macOS/Windows 에서 만든 베이스라인은 Linux 러너에서 전부 "missing snapshot" 이 되어
